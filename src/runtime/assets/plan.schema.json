{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Syrin clean immutable file plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "planId",
    "sessionId",
    "operation",
    "ownerSid",
    "root",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "syrin-file-plan"
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "operation": {
      "enum": [
        "quarantine",
        "restore",
        "purge",
        "resume",
        "import"
      ]
    },
    "ownerSid": {
      "type": "string"
    },
    "root": {
      "type": "string"
    },
    "rootId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{32}$"
    },
    "legacyRoot": {
      "type": "string"
    },
    "createdUtc": {
      "type": "string"
    },
    "conflict": {
      "enum": [
        "skip",
        "rename"
      ]
    },
    "measuredBytes": {
      "type": "integer",
      "minimum": 0
    },
    "estimatedReclaimableBytes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "protectedPaths",
        "files"
      ],
      "properties": {
        "mode": {
          "enum": [
            "audit",
            "approve"
          ]
        },
        "protectedPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "groupId",
          "directory",
          "itemCount",
          "measuredBytes",
          "firstCode",
          "lastCode",
          "sampleFiles"
        ],
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^G[1-9][0-9]*$"
          },
          "directory": {
            "type": "string"
          },
          "itemCount": {
            "type": "integer",
            "minimum": 1
          },
          "measuredBytes": {
            "type": "integer",
            "minimum": 0
          },
          "firstCode": {
            "type": "string"
          },
          "lastCode": {
            "type": "string"
          },
          "sampleFiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "original",
          "stored",
          "fingerprint",
          "destination",
          "expectedState"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "code": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "stored": {
            "type": "string"
          },
          "fingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "FileId",
              "Length",
              "LastWriteUtc",
              "Links"
            ],
            "properties": {
              "FileId": {
                "type": "string"
              },
              "Length": {
                "type": "integer",
                "minimum": 0
              },
              "LastWriteUtc": {
                "type": "string"
              },
              "Links": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "destination": {
            "type": "string"
          },
          "expectedState": {
            "type": "string"
          }
        }
      }
    }
  }
}
